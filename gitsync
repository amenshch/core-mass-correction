#!/bin/bash
# gsync -- send local changes of a repository to GitHub, or get changes from it.
#
# Run inside the repository folder (or any folder below it):
#   gsync                  show what has changed locally
#   gsync "message"        add all new and changed files, commit with this message, push
#   gsync get              get the latest version from GitHub
#   gsync rm <file>...     delete files (locally and, after the next push, on GitHub)
#   gsync log              list the last 15 commits
#
# Files are added by copying them into the folder (Finder or cp); deleted files are
# also recorded by "gsync message".  Works with the bash 3.2 that comes with macOS.

set -e
git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "Not inside a git repository."; exit 1; }
cd "$(git rev-parse --show-toplevel)"

case "$1" in
  "")
    git status --short
    [ -z "$(git status --porcelain)" ] && echo "Nothing changed."
    ;;
  get)
    git pull --quiet --rebase && echo "Up to date with GitHub."
    ;;
  rm)
    shift; git rm --quiet -r -- "$@" && echo "Removed: $*  (run gsync \"message\" to push)"
    ;;
  log)
    git log --oneline -15
    ;;
  *)
    git pull --quiet --rebase 2>/dev/null || true
    git add -A
    if git diff --cached --quiet; then echo "Nothing to commit."; exit 0; fi
    git diff --cached --stat | tail -1
    git commit --quiet -m "$1"
    git push --quiet && echo "Pushed: $1"
    ;;
esac
